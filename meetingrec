#!/usr/bin/env bash
# Wrapper that runs the meetingrec CLI from its uv-managed venv.
set -euo pipefail

script_path="$(readlink -f "${BASH_SOURCE[0]}")"
project_dir="$(cd "$(dirname "$script_path")" && pwd)"

# --inexact keeps optional extras (e.g. diarize) installed by `uv sync --extra ...`.
exec uv run --inexact --project "$project_dir" meetingrec "$@"
